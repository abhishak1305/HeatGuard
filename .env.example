# Local-development example only. Do not use these values for production.
# Django does not load this file automatically. Generate a unique production
# key and configure production hosts and HTTPS settings in the deployment system.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
# Enable only after confirming the whole domain/subdomain deployment is HTTPS-only.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
# Optional bootstrap passwords; setup_roles never prints them.
# HEATGUARD_DEMO_USER_PASSWORD=
# HEATGUARD_STAFF_USER_PASSWORD=
